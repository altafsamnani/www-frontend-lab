    "@vee-validate/i18n": "^4.11.8",
    "@vee-validate/rules": "^4.11.8",
    "@vue/cli": "^5.0.8",
    "axios": "^1.5.1",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.10",
    "moment": "^2.30.1",
    "pinia": "^2.1.7",
    "primeicons": "^6.0.1",
    "primevue": "^4.0.0",
    "tailwindcss-primeui": "^0.3.4",
    "vee-validate": "^4.11.8",
    "vue": "^3.4.20",
    "vue-chartjs": "^5.2.0",
    "vue-i18n": "^9.5.0",
    "vue-router": "^4.2.5",
    "vuedraggable": "^4.1.0"
