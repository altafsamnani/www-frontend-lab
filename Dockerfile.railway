# Build stage
FROM node:20-alpine AS build-stage

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Set Railway environment variables
ENV NODE_ENV=production \
    VITE_BASE_URL=https://osec.up.railway.app \
    VITE_API_URL=https://osec-api.up.railway.app/www \
    VITE_API_BASE_URL=https://osec-api.up.railway.app \
    VITE_DEFAULT_LOCALE=en \
    VITE_DEFAULT_CURRENCY=EUR \
    VITE_APP_TITLE=Osec \
    VITE_ALLOWED_FILE_TYPES="application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,application/pdf,image/x-png,image/gif,image/jpeg,image/png,application/zip" \
    VITE_ALLOWED_IMAGE_TYPES="image/x-png,image/gif,image/jpeg" \
    VITE_S3_ENDPOINT=https://d2shs8akuqsy6x.cloudfront.net \
    VITE_S3_BUCKET=osec-uploads \
    VITE_DEFAULT_IMAGE="https://d2shs8akuqsy6x.cloudfront.net/eyJidWNrZXQiOiJvc2VjLWltYWdlcyIsImtleSI6ImRlZmF1bHRzL25vaW1hZ2UucG5nIiwiZWRpdHMiOnsicmVzaXplIjp7IndpZHRoIjozMDAsImhlaWdodCI6MjAwLCJmaXQiOiJmaWxsIn19fQ=="

# Build Vue app and copy fonts to both locations for compatibility
RUN npm run build-only && \
    cp -r node_modules/primeicons/fonts dist/ && \
    mkdir -p dist/assets && \
    cp -r node_modules/primeicons/fonts dist/assets/

# Production stage
FROM nginx:alpine AS production-stage

# Copy built Vue app
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY nginx.conf /etc/nginx/conf.d/default.conf.template

# Copy startup script
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Expose default port
EXPOSE 8080

# Start with our custom script
CMD ["/start.sh"]